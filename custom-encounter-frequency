// Updated Qualtrics question with restore-on-load + i18n (tr/ar/en/fa)
Qualtrics.SurveyEngine.addOnload(function () {
  // --- Dil algılama: Q_Language -> tr/ar/en/fa (varsayılan: en) ---
  var qLang = (Qualtrics.SurveyEngine.getEmbeddedData("Q_Language") || "EN").toUpperCase();
  var lang =
    qLang === "TR" ? "tr" :
    qLang === "AR" ? "ar" :
    qLang === "FA" ? "fa" : "en";

  // RTL dilleri için yön
  var container = this.getQuestionContainer();
  container.setAttribute("dir", (lang === "ar" || lang === "fa") ? "rtl" : "ltr");

  // Başlık (opsiyonel)
  var title = document.createElement("p");
  title.textContent = ""; // istersen dil bazlı başlık koy
  title.style.fontWeight = "bold";
  title.style.marginBottom = "10px";
  container.appendChild(title);

  // --- Kurum adları: tr/ar/en/fa ---
  function T(tr, ar, en, fa) {
    return lang === "tr" ? tr : lang === "ar" ? ar : lang === "fa" ? fa : en;
  }

  var ngos = [
    { id: "courthouse",    name: T("Adliye Görevlileri", "الموظفون في المحكمة", "Courthouse Staff", "کارکنان دادگاه") },
    { id: "ashim",         name: T("Aile ve Sosyal Hizmetler İl Müdürlüğü (ASHİM)", "مديرية الأسرة والخدمات الاجتماعية (ASHİM)", "Provincial Directorate of Family and Social Services (ASHİM)", "مدیریت استانی خانواده و خدمات اجتماعی (ASHİM)") },
    { id: "aileburo",      name: T("Aile İçi ve Kadına Karşı Şiddetle Mücadele Şube Müdürlüğü", "مديرية مكافحة العنف الأسري والعنف ضد المرأة", "Domestic Violence & Violence Against Women Branch Directorate", "اداره مبارزه با خشونت خانگی و خشونت علیه زنان") },
    { id: "hospital",      name: T("Bulunduğunuz ilçedeki hastane", "المستشفى في القضاء الذي تسكن فيه", "Hospital in your district", "بیمارستان در شهرستان محل سکونت شما") },
    { id: "school",        name: T("Bulunduğunuz mahalledeki okul", "المدرسة في الحي الذي تسكن فيه", "School in your neighborhood", "مدرسه در محله شما") },
    { id: "codem",         name: T("Çocuk Destek Merkezleri (ÇODEM)", "مراكز دعم الأطفال (ÇODEM)", "Child Support Centers (ÇODEM)", "مراکز حمایت از کودک (ÇODEM)") },
    { id: "cocukev",       name: T("Çocuk Evleri", "بيوت الأطفال", "Children’s Homes", "خانه‌های کودک") },
    { id: "cim",           name: T("Çocuk İzlem Merkezi (ÇİM) Çalışanları", "مركز مراقبة الأطفال (ÇİM) – الموظفون", "Child Monitoring Center (ÇİM) – Staff", "مرکز پایش کودک (Çİم) – کارکنان") },
    { id: "policecocuk",   name: T("Çocuk Şube Müdürlüğü Çalışanları", "قسم شرطة الأطفال – الموظفون", "Children’s Police Department – Staff", "اداره پلیس کودکان – کارکنان") },
    { id: "return",        name: T("Geri Gönderme Merkezi Görevlileri", "الموظفون في مركز الترحيل", "Removal Center Staff", "کارکنان مرکز بازگرداندن") },
    { id: "province_muni", name: T("İl Belediyesi Çalışanları", "موظفو البلدية (المحافظة)", "Metropolitan/Provincial Municipality Staff", "کارکنان شهرداری (استان)") },
    { id: "district_muni", name: T("İlçe Belediyesi Çalışanları", "موظفو البلدية (القضاء)", "District Municipality Staff", "کارکنان شهرداری (ناحیه/بخش)") },
    { id: "iskur",         name: T("İŞKUR Çalışanları", "موظفو مؤسسة İŞKUR", "İŞKUR Staff", "کارکنان İŞKUR") },
    { id: "kadsig",        name: T("Kadın Sığınma Evi Çalışanları", "موظفو دار إيواء النساء", "Women’s Shelter Staff", "کارکنان خانه امن زنان") },
    { id: "notary",        name: T("Noter", "كاتب العدل", "Notary", "دفتر اسناد رسمی") },
    { id: "police",        name: T("Polis Memurları", "ضباط الشرطة", "Police Officers", "افسران پلیس") },
    { id: "sonim",         name: T("Şiddet Önleme ve İzleme Merkezleri (ŞÖNİM)", "مراكز منع ومراقبة العنف (ŞÖNİM)", "Violence Prevention & Monitoring Centers (ŞÖNİM)", "مراکز پیشگیری و پایش خشونت (ŞÖNİM)") },
    { id: "sydv",          name: T("Sosyal Yardımlaşma ve Dayanışma Vakfı (SYDV) Çalışanları", "مؤسسة التضامن والمساعدة الاجتماعية (SYDV) – الموظفون", "Social Assistance & Solidarity Foundation (SYDV) – Staff", "بنیاد همیاری و همبستگی اجتماعی (SYDV) – کارکنان") },
    { id: "other",         name: T("Diğer (lütfen belirtiniz)", "أخرى (يرجى التوضيح)", "Other (please specify)", "سایر (لطفاً توضیح دهید)") }
  ];

  // --- Etiketler / seçenekler ---
  var labels = (function () {
    if (lang === "tr") {
      return {
        freqQuestion: "Ne sıklıkta bu kurumla görüşmeniz gerekiyordu?",
        freqOptions: ['Her gün', 'Haftada 1–2 kez', 'Haftada 3–4 kez', 'Ayda 1–2 kez', 'Ayda 3–4 kez', '3–4 ayda bir'],
        otherLabel: "Diğer",
        otherFreqPlaceholder: "lütfen belirtiniz",
        otherInstitutionPlaceholder: "Kamu Kurumunun Adını Belirtiniz"
      };
    } else if (lang === "ar") {
      return {
        freqQuestion: "كم مرة كنت تحتاج للتواصل مع هذه الجهة؟",
        freqOptions: ['كل يوم', '1–2 مرة في الأسبوع', '3–4 مرات في الأسبوع', '1–2 مرة في الشهر', '3–4 مرات في الشهر', 'مرة كل 3–4 أشهر'],
        otherLabel: "أخرى",
        otherFreqPlaceholder: "يرجى التوضيح",
        otherInstitutionPlaceholder: "يرجى ذكر اسم المؤسسة الحكومية"
      };
    } else if (lang === "fa") {
      return {
        freqQuestion: "هر چند وقت یک‌بار لازم بود با این نهاد در ارتباط باشید؟",
        freqOptions: ['هر روز', '۱–۲ بار در هفته', '۳–۴ بار در هفته', '۱–۲ بار در ماه', '۳–۴ بار در ماه', 'هر ۳–۴ ماه یک‌بار'],
        otherLabel: "سایر",
        otherFreqPlaceholder: "لطفاً توضیح دهید",
        otherInstitutionPlaceholder: "لطفاً نام نهاد دولتی را ذکر کنید"
      };
    } else { // en
      return {
        freqQuestion: "How often did you need to contact this institution?",
        freqOptions: ['Every day', '1–2 times/week', '3–4 times/week', '1–2 times/month', '3–4 times/month', 'Once every 3–4 months'],
        otherLabel: "Other",
        otherFreqPlaceholder: "please specify",
        otherInstitutionPlaceholder: "Please specify the name of the public institution"
      };
    }
  })();

  // --- UI oluşturma ---
  ngos.forEach(function (ngo) {
    var box = document.createElement("div");
    box.className = "checkbox-wrapper";
    box.style.marginBottom = "12px";

    var checkboxDiv = document.createElement("div");
    checkboxDiv.className = "q-checkbox";

    var checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.id = "cb-" + ngo.id;

    var label = document.createElement("label");
    label.setAttribute("for", checkbox.id);
    label.innerHTML = "<strong>" + ngo.name + "</strong>";

    checkboxDiv.appendChild(checkbox);
    checkboxDiv.appendChild(label);

    var followUpDiv = document.createElement("div");
    followUpDiv.id = "followup-" + ngo.id;
    followUpDiv.className = "follow-up";
    followUpDiv.style.marginInlineStart = "20px"; // RTL/LTR uyumlu
    followUpDiv.style.marginTop = "10px";
    followUpDiv.style.display = "none";

    // Sıklık seçenekleri
    var freqOptionsHtml = labels.freqOptions.map(function (labelText) {
      // TR'de görsel kırılımı koru, diğerlerinde tek satır
      var visible = (lang === "tr") ? labelText.replace(" ", "<br>") : labelText;
      return '<label style="font-size: 13px; margin: 4px 8px; display: inline-block; min-width: 140px; text-align: center;">' +
               '<input type="radio" name="memory-' + ngo.id + '" value="' + labelText + '"><div>' + visible + '</div>' +
             '</label>';
    }).join('');

    followUpDiv.innerHTML =
      (ngo.id === "other"
        ? '<div style="margin-bottom: 10px;">' +
            '<input type="text" name="otherText" placeholder="' + labels.otherInstitutionPlaceholder + '" style="width: 500px;" class="other-text-' + ngo.id + '">' +
          '</div>'
        : '') +
      '<p>' + labels.freqQuestion + '</p>' +
      '<div style="display: flex; justify-content: ' + ((lang === "ar" || lang === "fa") ? 'flex-start' : 'space-between') + '; flex-wrap: wrap; margin-bottom: 10px;">' +
        freqOptionsHtml +
      '</div>' +
      '<div style="display: flex; align-items: center; margin-inline-start: 35px;">' +
        '<label style="font-size: 13px; display: flex; align-items: center;">' +
          '<input type="radio" name="memory-' + ngo.id + '" value="' + labels.otherLabel + '" class="other-frequency-radio">' +
          '<span style="margin-inline-start: 6px;">' + labels.otherLabel + '</span>' +
        '</label>' +
        '<input type="text" class="other-frequency-input" placeholder="' + labels.otherFreqPlaceholder + '" style="margin-inline-start: 8px; width: 200px; font-size: 13px; display: none;">' +
      '</div>';

    box.appendChild(checkboxDiv);
    box.appendChild(followUpDiv);
    container.appendChild(box);

    // --- Önceki durumu geri yükle ---
    var selected = Qualtrics.SurveyEngine.getEmbeddedData("kurum_" + ngo.id + "_secildi");
    if (selected === "1") {
      checkbox.checked = true;
      followUpDiv.style.display = "block";

      var storedFreq  = Qualtrics.SurveyEngine.getEmbeddedData("kurum_" + ngo.id + "_siklik");
      var storedOther = Qualtrics.SurveyEngine.getEmbeddedData("kurum_" + ngo.id + "_diger");

      if (storedFreq) {
        var radio = followUpDiv.querySelector('input[type="radio"][value="' + storedFreq + '"]');
        if (radio) radio.checked = true;
        if (radio && radio.classList.contains("other-frequency-radio")) {
          var inputBox = followUpDiv.querySelector(".other-frequency-input");
          if (inputBox) {
            inputBox.style.display = "inline-block";
            if (storedOther) inputBox.value = storedOther;
          }
        }
      }
    }

    // --- Görünürlük & "Diğer" serbest metin ---
    function wireOtherVisibility(div) {
      var radios = div.querySelectorAll("input[type='radio']");
      var inputBox = div.querySelector(".other-frequency-input");
      radios.forEach(function (r) {
        r.addEventListener("change", function () {
          if (r.classList.contains("other-frequency-radio") && r.checked) {
            if (inputBox) inputBox.style.display = "inline-block";
          } else if (inputBox) {
            inputBox.style.display = "none";
          }
        });
      });
    }

    wireOtherVisibility(followUpDiv);

    checkbox.addEventListener("change", function () {
      if (checkbox.checked) {
        followUpDiv.style.display = "block";
      } else {
        followUpDiv.style.display = "none";
        var radios = followUpDiv.querySelectorAll("input[type='radio']");
        radios.forEach(function (r) { r.checked = false; });
        var inputBox = followUpDiv.querySelector(".other-frequency-input");
        if (inputBox) inputBox.style.display = "none";
      }
    });
  });

  // --- Kaydetme (embedded data) + En sık kurum hesaplama ---
  this.questionclick = function () {
    // Dil bağımsız puanlama tablosu (etiket → puan)
    var freqScores = {
      // 5
      "Her gün": 5, "كل يوم": 5, "هر روز": 5, "Every day": 5,
      // 4
      "Haftada 1–2 kez": 4, "1–2 مرة في الأسبوع": 4, "۱–۲ بار در هفته": 4, "1–2 times/week": 4,
      // 3
      "Haftada 3–4 kez": 3, "3–4 مرات في الأسبوع": 3, "۳–۴ بار در هفته": 3, "3–4 times/week": 3,
      // 2
      "Ayda 1–2 kez": 2, "1–2 مرة في الشهر": 2, "۱–۲ بار در ماه": 2, "1–2 times/month": 2,
      // 1.5
      "Ayda 3–4 kez": 1.5, "3–4 مرات في الشهر": 1.5, "۳–۴ بار در ماه": 1.5, "3–4 times/month": 1.5,
      // 1
      "3–4 ayda bir": 1, "مرة كل 3–4 أشهر": 1, "هر ۳–۴ ماه یک‌بار": 1, "Once every 3–4 months": 1
    };

    var results = [];

    ngos.forEach(function (ngo) {
      var checkbox    = document.getElementById("cb-" + ngo.id);
      var followUpDiv = document.getElementById("followup-" + ngo.id);
      var checked     = checkbox && checkbox.checked;

      Qualtrics.SurveyEngine.setEmbeddedData("kurum_" + ngo.id + "_secildi", checked ? "1" : "0");

      var selectedRadio  = followUpDiv ? followUpDiv.querySelector("input[type='radio']:checked") : null;
      var frequencyValue = selectedRadio ? selectedRadio.value : "";
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_" + ngo.id + "_siklik", frequencyValue);

      var otherInput = followUpDiv ? followUpDiv.querySelector(".other-frequency-input") : null;
      var otherText  = (selectedRadio && selectedRadio.classList.contains("other-frequency-radio") && otherInput) ? otherInput.value : "";
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_" + ngo.id + "_diger", otherText);

      if (ngo.id === "other" && otherText) {
        Qualtrics.SurveyEngine.setEmbeddedData("kurum_other_adi", otherText);
      }

      // skor hesaplama: sadece checkbox işaretli ve bir sıklık seçilmişse
      if (checked && frequencyValue) {
        // "Diğer" sıklık seçeneği (serbest metin) için puan 0 olsun
        var score = selectedRadio.classList.contains("other-frequency-radio") ? 0 : (freqScores[frequencyValue] || 0);
        results.push({ id: ngo.id, name: ngo.name, freq: frequencyValue, score: score });
      }
    });

    // En yüksek puanı bul ve yaz
    if (results.length > 0) {
      var maxScore = Math.max.apply(null, results.map(function(r){ return r.score; }));
      var topOnes = results.filter(function(r){ return r.score === maxScore; });

      // Berabere ise rastgele seç
      var chosen = topOnes[Math.floor(Math.random() * topOnes.length)];

      // Tekil kayıt
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_en_sik_id", chosen.id);
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_en_sik_ad", chosen.name);
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_en_sik_siklik", chosen.freq);
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_en_sik_puan", String(chosen.score));

      // Berabere olanların hepsi (liste)
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_en_sik_hepsi_id", topOnes.map(function(r){ return r.id; }).join(","));
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_en_sik_hepsi_ad", topOnes.map(function(r){ return r.name; }).join(","));
    } else {
      // hiçbir şey seçilmemişse temizle (opsiyonel)
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_en_sik_id", "");
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_en_sik_ad", "");
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_en_sik_siklik", "");
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_en_sik_puan", "");
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_en_sik_hepsi_id", "");
      Qualtrics.SurveyEngine.setEmbeddedData("kurum_en_sik_hepsi_ad", "");
    }
  };
});
